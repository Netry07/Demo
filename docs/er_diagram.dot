digraph ER {
  graph [rankdir=LR, splines=true, nodesep=0.6, ranksep=1.2, fontname="Helvetica"];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, arrowhead=crow, arrowtail=tee, dir=both];
  "users" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#D9E2F3"><B>users</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="CENTER" WIDTH="30">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="role">role</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">full_name</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR><TR><TD ALIGN="LEFT" PORT="login">login</TD><TD ALIGN="CENTER" WIDTH="30">UK</TD></TR><TR><TD ALIGN="LEFT" PORT="password">password</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR></TABLE>>];
  "products" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#D9E2F3"><B>products</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="CENTER" WIDTH="30">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="article">article</TD><TD ALIGN="CENTER" WIDTH="30">UK</TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_of_measurement">unit_of_measurement</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR><TR><TD ALIGN="LEFT" PORT="price">price</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR><TR><TD ALIGN="LEFT" PORT="provider">provider</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR><TR><TD ALIGN="LEFT" PORT="category">category</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR><TR><TD ALIGN="LEFT" PORT="discount">discount</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR><TR><TD ALIGN="LEFT" PORT="count">count</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR><TR><TD ALIGN="LEFT" PORT="image">image</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR></TABLE>>];
  "pickup_points" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#D9E2F3"><B>pickup_points</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="CENTER" WIDTH="30">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="full_address">full_address</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR></TABLE>>];
  "order" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#D9E2F3"><B>order</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="CENTER" WIDTH="30">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="article">article</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="CENTER" WIDTH="30">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="pick_up_id">pick_up_id</TD><TD ALIGN="CENTER" WIDTH="30">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR><TR><TD ALIGN="LEFT" PORT="delivered_at">delivered_at</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">full_name</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR><TR><TD ALIGN="LEFT" PORT="recipient_code">recipient_code</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR></TABLE>>];
  "order_items" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#D9E2F3"><B>order_items</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="CENTER" WIDTH="30">PK</TD></TR><TR><TD ALIGN="LEFT" PORT="order_id">order_id</TD><TD ALIGN="CENTER" WIDTH="30">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="goods_id">goods_id</TD><TD ALIGN="CENTER" WIDTH="30">FK</TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR><TR><TD ALIGN="LEFT" PORT="total_price">total_price</TD><TD ALIGN="CENTER" WIDTH="30"></TD></TR></TABLE>>];
  "users":id:e -> "order":user_id:w [label="1 : N"];
  "pickup_points":id:e -> "order":pick_up_id:w [label="1 : N"];
  "order":id:e -> "order_items":order_id:w [label="1 : N"];
  "products":id:e -> "order_items":goods_id:w [label="1 : N"];
}
